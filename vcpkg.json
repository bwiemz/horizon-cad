{
  "name": "horizon-cad",
  "version": "0.1.0",
  "description": "Open-source parametric 2D/3D CAD software",
  "dependencies": [
    "spdlog",
    "nlohmann-json",
    "gtest",
    "eigen3",
    "flatbuffers"
  ],
  "default-features": [
    "qt"
  ],
  "features": {
    "qt": {
      "description": "Build Qt 6 with vcpkg: what the application needs to show a window and draw text (FreeType, HarfBuzz; on Linux fontconfig and the xcb platform plugin), and nothing more. Turn off (VCPKG_MANIFEST_NO_DEFAULT_FEATURES=ON, or the linux-system-qt preset) to build against an installed Qt 6.",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "widgets",
            "opengl",
            "freetype",
            "harfbuzz",
            "png",
            {
              "name": "fontconfig",
              "platform": "linux"
            },
            {
              "name": "xcb",
              "platform": "linux"
            },
            {
              "name": "xcb-xlib",
              "platform": "linux"
            }
          ]
        }
      ]
    }
  },
  "builtin-baseline": "84bab45d415d22042bd0b9081aea57f362da3f35"
}
