ISO-10303-21;
HEADER;
/* Hand-authored fixture: a nested assembly with its placements (Phase 153).
   Top uses Sub at (100,0,0) mm; Sub, whose representation is in
   centimetres, uses Part A at (1,0,0) cm turned 90 degrees about z; Top
   also uses Part A at (0,0,50) mm, and Part B at (0,30,0) mm, that last
   relationship written with the assembly first (rep_1) and its
   transformation's items the other way round, as some writers do.
   Part A is written the OCC way (a SHAPE_REPRESENTATION related to the
   ADVANCED_BREP one without a transformation); Part B's shape is its
   ADVANCED_BREP representation, and its name is escaped (Gr\X2\00FC\X0\n).
   Parts: two tetrahedra with legs 10; B's drawn +20 in x. Volume of each
   1000/6. Expected centroids: A in Sub (107.5,2.5,2.5), A in Top
   (2.5,2.5,52.5), B (22.5,32.5,2.5). */
FILE_DESCRIPTION(('nested assembly fixture'),'2;1');
FILE_NAME('assembly_nested_placed.step','2026-09-25T12:00:00',('Horizon fixtures'),(''),
  'none','none','none');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
