<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Make UTF-8 the process code page (Windows 10 1903+). Paths travel through the
  application as UTF-8 std::string (QString::toStdString), and every narrow
  Windows API and std::filesystem conversion reads them in the active code
  page; without this, a file under C:\Users\José could not be opened or saved.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
